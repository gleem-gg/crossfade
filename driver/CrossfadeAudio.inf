; CrossfadeAudio.inf - Crossfade virtual audio driver.
;
; A root-enumerated PortCls adapter exposing two virtual microphones
; ("Crossfade Stream Mix", "Crossfade VOD Mix") fed by the Crossfade app,
; and eight virtual outputs ("Crossfade Channel 1..8") the app records.
; Subdevice names and pin-name GUIDs must match src/adapter.cpp.

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 01/01/2026,0.9.0.0
CatalogFile = CrossfadeAudio.cat
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
CrossfadeAudio.sys = 1

[DestinationDirs]
DefaultDestDir = 13

[Manufacturer]
%MfgName% = Crossfade, NTamd64.10.0...19041, NTarm64.10.0...19041

[Crossfade.NTamd64.10.0...19041]
%DeviceDesc% = Crossfade_Device, ROOT\CrossfadeAudio

[Crossfade.NTarm64.10.0...19041]
%DeviceDesc% = Crossfade_Device, ROOT\CrossfadeAudio

[Crossfade_Device.NT]
Include  = ks.inf, wdmaudio.inf
Needs    = KS.Registration, WDMAUDIO.Registration
CopyFiles = Crossfade.CopyFiles
AddReg   = Crossfade.AddReg

[Crossfade.CopyFiles]
CrossfadeAudio.sys

[Crossfade.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,CrossfadeAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%
; Endpoint descriptions, keyed by the topology bridge pins' Name GUIDs.
HKLM,%MediaCategories%\%Pin.StreamMix%,Name,,%Desc.StreamMix%
HKLM,%MediaCategories%\%Pin.StreamMix%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.VodMix%,Name,,%Desc.VodMix%
HKLM,%MediaCategories%\%Pin.VodMix%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.Ch1%,Name,,%Desc.Ch1%
HKLM,%MediaCategories%\%Pin.Ch1%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.Ch2%,Name,,%Desc.Ch2%
HKLM,%MediaCategories%\%Pin.Ch2%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.Ch3%,Name,,%Desc.Ch3%
HKLM,%MediaCategories%\%Pin.Ch3%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.Ch4%,Name,,%Desc.Ch4%
HKLM,%MediaCategories%\%Pin.Ch4%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.Ch5%,Name,,%Desc.Ch5%
HKLM,%MediaCategories%\%Pin.Ch5%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.Ch6%,Name,,%Desc.Ch6%
HKLM,%MediaCategories%\%Pin.Ch6%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.Ch7%,Name,,%Desc.Ch7%
HKLM,%MediaCategories%\%Pin.Ch7%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Pin.Ch8%,Name,,%Desc.Ch8%
HKLM,%MediaCategories%\%Pin.Ch8%,Display,1,00,00,00,00

