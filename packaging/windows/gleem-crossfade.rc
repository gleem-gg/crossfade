// Windows resources for gleem-crossfade.exe. A template: build.rs fills in
// the @...@ placeholders (version from Cargo.toml, absolute icon path) and
// compiles the result.
#include <winver.h>

// The first icon resource is what Explorer, the taskbar and shortcuts show
// for the executable.
1 ICON "@ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @VERSION_COMMA@
 PRODUCTVERSION  @VERSION_COMMA@
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      L"Anikeen UG (haftungsbeschr\x00e4nkt) & Co. KG"
            VALUE "FileDescription",  L"Gleem Crossfade"
            VALUE "FileVersion",      L"@VERSION@"
            VALUE "InternalName",     L"gleem-crossfade"
            VALUE "LegalCopyright",   L"\x00a9 2026 Anikeen UG (haftungsbeschr\x00e4nkt) & Co. KG"
            VALUE "OriginalFilename", L"gleem-crossfade.exe"
            VALUE "ProductName",      L"Gleem Crossfade"
            VALUE "ProductVersion",   L"@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
